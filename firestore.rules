rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Set this custom claim only from a trusted Admin SDK environment.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function hasUserProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myOrgId() {
      return hasUserProfile() ? userDoc(request.auth.uid).data.orgId : null;
    }

    function sameOrg() {
      return signedIn()
        && hasUserProfile()
        && resource.data.orgId != null
        && resource.data.orgId == myOrgId();
    }

    // User profiles. A user cannot grant themselves admin or activate their own subscription.
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin()
        || (resource.data.orgId != null && resource.data.orgId == myOrgId()));

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ['broker', 'brokerage_owner']
        && request.resource.data.subscriptionStatus in ['free', 'pending'];

      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'permissions', 'orgId', 'subscriptionExpiry', 'admin', 'isAdmin'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscriptionStatus'])
          || request.resource.data.subscriptionStatus in ['free', 'pending', 'expired']
        )
      );

      allow delete: if isAdmin();
    }

    // Organization metadata: owners can create their own organization; admin controls membership.
    match /organizations/{orgId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow read: if signedIn() && (
        isAdmin() || resource.data.ownerId == request.auth.uid || orgId == myOrgId()
      );
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
      );
      allow delete: if isAdmin();
    }

    // Subscription requests: users may create/read their own requests; only admin can review/change them.
    match /subscriptionRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.plan == 'monthly'
        && request.resource.data.price is number
        && request.resource.data.orgId == myOrgId();

      allow get, list: if signedIn() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );

      allow update, delete: if isAdmin();
    }

    // Audit records are append-only for members of the same organization.
    match /auditLogs/{logId} {
      allow create: if signedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.orgId == myOrgId();
      allow read: if isAdmin() || sameOrg();
      allow update, delete: if isAdmin();
    }

    // App data collections use orgId scoping. Reads/writes must stay inside the signed-in user's org.
    // This wildcard covers collections such as clients, policies, claims, renewals, tasks, etc.
    match /{collection}/{documentId} {
      allow read: if isAdmin() || sameOrg();
      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.orgId == myOrgId()
        && request.resource.data.createdBy == request.auth.uid
      );
      allow update: if isAdmin() || (
        sameOrg()
        && request.resource.data.orgId == resource.data.orgId
      );
      allow delete: if isAdmin() || sameOrg();
    }
  }
}
