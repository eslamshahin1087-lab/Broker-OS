rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function currentOrganizationId() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data.organizationId;
    }

    function sameOrganization(orgId) {
      return signedIn() && orgId == currentOrganizationId();
    }

    function canManageDocuments(orgId) {
      return sameOrganization(orgId)
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.role in ['owner', 'admin', 'operations'];
    }

    function supportedFile() {
      return request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'image/jpeg',
          'image/png',
          'image/webp',
          'text/plain',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.ms-excel',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
        ];
    }

    match /organizations/{organizationId}/documents/{documentId}/{fileName} {
      allow read: if sameOrganization(organizationId);

      allow create: if sameOrganization(organizationId)
        && supportedFile();

      allow update: if sameOrganization(organizationId)
        && supportedFile();

      allow delete: if canManageDocuments(organizationId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
